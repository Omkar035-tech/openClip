{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "openclip-studio",
  "version": "1.0.0",
  "identifier": "com.openclip.studio",
  "build": {
    "frontendDist": "../clipper/src/clipper/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "openClip Studio - AI Video Editor",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
